{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eotra-web-2026",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/*.png", "!/*.jpg", "!/*.jpeg", "!/*.svg", "!/*.webmanifest", "!/*.ico", "!/*.webp"]
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "VIEWS"
    }
  ]
}
